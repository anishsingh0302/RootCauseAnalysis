{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Routing": "Debug",
      "Microsoft.AspNetCore.Mvc": "Debug"
    }
  },
  "Notifications": {
    "ApiBaseUrl": "https://appliance-goofiness-fidelity.ngrok-free.dev",
    "TeamsWebhookUrl": "",  // Paste your Teams webhook URL here for testing
    "NotifyOnAllFailures": true,
    "NotifyOnNewPatterns": true,
    "MinConfidenceForNotification": 0.7,
    "PostToGitHubPRs": false,
    "CreateGitHubIssuesForPatterns": false,
    "CreateAutoFixPRs": true,  // Enable automatic PR creation with fixes for testing
    "MinConfidenceForAutoFixPR": 0.85  // Lower threshold for development/testing
  }
}
