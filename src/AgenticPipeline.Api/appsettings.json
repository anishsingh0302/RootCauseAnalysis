{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pipeline.db"
  },
  "Claude": {
    "ModelId": "us.anthropic.claude-sonnet-4-6",
    "Region": "us-west-2",
    "MaxTokens": 8192,
    "Temperature": 0.7
  },
    "GitHub": {
        "PersonalAccessToken": "", // DO NOT put token here! Use environment variables instead
        "DefaultOwner": "anishsingh0302",
        "DefaultRepo": "Semantic-Kernel",
        "WebhookSecret": "" // DO NOT put token here! Use environment variables instead
    },
    "AzureDevOps": {
        "Organization": "anishsingh0302", // Your Azure DevOps organization name (just the name, not full URL)
        "PersonalAccessToken": "", // DO NOT put token here! Use environment variables instead
        "DefaultProject": "AgenticPipeline", // Your default project name
        "WebhookSecret": "", // Optional webhook secret
        "ApiVersion": "7.1"
    },
  "Embedding": {
    "ModelId": "amazon.titan-embed-text-v2:0",
    "Dimensions": 512,
    "MaxInputLength": 8192,
    "NormalizeEmbeddings": true
  },
  "Notifications": {
    "ApiBaseUrl": "https://localhost:7056",  // Your API URL (use ngrok URL for external access)
    "TeamsWebhookUrl": "",  // Optional: Microsoft Teams incoming webhook URL
    "SlackWebhookUrl": "",  // Optional: Slack incoming webhook URL (not yet implemented)
    "NotifyOnAllFailures": false,
    "NotifyOnNewPatterns": true,
    "MinConfidenceForNotification": 0.8,
    "PostToGitHubPRs": false,
    "CreateGitHubIssuesForPatterns": false,
    "CreateAutoFixPRs": false,  // Enable automatic PR creation with fixes
    "MinConfidenceForAutoFixPR": 0.9  // Minimum confidence (0.0-1.0) to create auto-fix PRs
  },
  "AutoFix": {
    "EnableValidation": true,  // Enable multi-stage validation before committing fixes
    "MinConfidenceForCommit": 0.9,  // Minimum overall confidence (0.0-1.0) required to commit a fix
    "MaxFixRefinementAttempts": 3,  // Maximum refinement attempts when validation fails
    "EnableIterativeRetry": true,  // Enable retry on autofix branch failures
    "MaxBranchRetries": 3,  // Maximum retries on autofix branch before giving up
    "RequireExplicitErrorMatch": true,  // Require explicit error matching between analysis and fix
    "EnableImpactAnalysis": true  // Enable impact analysis before committing
  }
}
